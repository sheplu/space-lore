# space-lore reads ONLY from the official npmjs.org registry.
# This project-level pin wins over any user/global config or proxy env,
# so installs here never resolve through a registry mirror/proxy.
# (If you see non-npmjs hosts in package-lock.json "resolved" URLs,
# delete the lockfile and re-run `npm install` to regenerate it.)
registry=https://registry.npmjs.org/

# Supply-chain protections (mirrors the apkg/lib-shared posture):
# - Always keep a lockfile.
package-lock=true
# - Refuse versions published less than 2 days ago (most malicious
#   releases are caught and yanked inside that window).
min-release-age=2
# - Never run package lifecycle scripts on install.
ignore-scripts=true
# - Enforce the engines field in package.json.
engine-strict=true
# - Only allow registry tarballs and local directories as sources:
#   no git, file, or remote-URL dependencies.
allow-git=none
allow-file=none
allow-directory=all
allow-remote=none
# - npm audit fails on low+ findings; disable funding noise.
audit-level=low
fund=false
